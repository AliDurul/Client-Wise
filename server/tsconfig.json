{
  "compilerOptions": {
    /* Base Options */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,

    /* Strictness */
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowSyntheticDefaultImports": true,

    /* Transpiling */
    "module": "CommonJS",
    "target": "es2022",
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,

    /* Paths */
    "paths": {
      "*": ["./src/*", "./src/types/*"]
    }
  },
  "include": [
    "./src/**/*"
  ]
}